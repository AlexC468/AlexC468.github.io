<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Awesome Website</title>
    <!-- Link to our external CSS stylesheet for styling -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header Section: Contains the main title and introductory message -->
    <header>
        <h1>Welcome to My Website!</h1>
        <p>Built from scratch using HTML, CSS, and JavaScript.</p>
    </header>

    <!-- Main Content Section: Holds the core content of the webpage -->
    <main>
        <section class="card">
            <h2>About This Site</h2>
            <p>This is a starter website hosted directly on GitHub Pages. You can customize every single detail you see here!</p>
            
            <!-- An interactive button that will trigger our JavaScript function -->
            <button id="interactive-btn">Click Me!</button>
            <p id="message-text"></p>
        </section>
    </main>

    <!-- Footer Section: Appears at the bottom of the page -->
    <footer>
        <p>© 2026 Created with ❤️ by a Web Developer</p>
    </footer>

    <!-- Link to our external JavaScript file for interactive features -->
    <script src="script.js"></script>
</body>
</html>
